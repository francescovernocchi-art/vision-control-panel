# Kill switch locale (default OFF)
VISION_REMOTE_ENABLED=false

# mock = test locale senza cloud | supabase = backend reale (quando schema pronto)
VISION_REMOTE_MODE=mock

# status_only = solo GET_STATUS remoto | full = whitelist operativa (non ancora)
VISION_REMOTE_EXECUTION_POLICY=status_only

VISION_DEVICE_ID=VIS-TARANTO-01
VISION_DEVICE_NAME=PC VIS Taranto

VISION_BACKEND_PROVIDER=supabase
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Token dedicato Agent (NON è una chiave Supabase). In DB solo SHA-256.
VISION_AGENT_TOKEN=
# Legacy alias (opzionale): SUPABASE_AGENT_KEY=

VISION_HEARTBEAT_SECONDS=15
VISION_COMMAND_POLL_SECONDS=3

# Opzionali
# VISION_AGENT_VERSION=0.1.0
# VISION_VERSION=2.0-vision
