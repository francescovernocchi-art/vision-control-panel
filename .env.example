# Kill switch locale (default OFF)
VISION_REMOTE_ENABLED=false

# mock = test locale senza cloud | supabase = backend reale
# Requisiti supabase: RPC agent_* sul progetto Lovable + devices.device_id
# (vedi docs/VISION_CP_AGENT_THIN_CHANNEL.md)
VISION_REMOTE_MODE=mock

# status_only = thin channel (GET_STATUS / WAKE / DEACTIVATE) | full = whitelist operativa
VISION_REMOTE_EXECUTION_POLICY=status_only

VISION_DEVICE_ID=VIS-TARANTO-01
VISION_DEVICE_NAME=PC VIS Taranto

VISION_BACKEND_PROVIDER=supabase
# Esempio progetto: https://<project-ref>.supabase.co
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Token dedicato Agent (NON è una chiave Supabase). In DB solo SHA-256.
# Placeholder only — real token lives in local .env (never commit).
VISION_AGENT_TOKEN=
# Legacy alias (opzionale): SUPABASE_AGENT_KEY=

VISION_HEARTBEAT_SECONDS=15
VISION_COMMAND_POLL_SECONDS=3

# Opzionali
# VISION_AGENT_VERSION=0.1.0
# VISION_VERSION=2.0-vision

# Phase 2 — ModuleSettings read compatibility (default OFF = legacy AppSettings only)
# When true: EniSpaceConfigFacade may read ModuleSettings with AppSettings fallback.
# Does NOT write ModuleSettings.
VISION_USE_MODULE_SETTINGS_READ=false

# Phase 3C — operative path overrides (download/output). Requires BOTH flags true.
# Default OFF. Seed/default ModuleSettings never override Documents\VIS-ION without
# explicit_fields + this flag.
VISION_USE_MODULE_SETTINGS_PATHS_READ=false

# --- VISION Avatar 3D (Meshy Image-to-3D) ---
# Crea la key su https://www.meshy.ai/ → API Keys
# Poi: tools\blender_avatar\RUN_MESHY_AVATAR.bat
MESHY_API_KEY=
